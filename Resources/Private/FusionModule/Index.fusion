NEOSidekick.LinkChecker.Backend.ModuleController {
    index = afx`
        <NEOSidekick.LinkChecker:Component.FlashMessages flashMessages={flashMessages}/>
        <NEOSidekick.LinkChecker:Backend.Module.Index links={links} groupedLinks={groupedLinks}/>
    `

    run = afx`
        <NEOSidekick.LinkChecker:Component.FlashMessages flashMessages={flashMessages}/>
        Crawling was started come back later to the link checker to see the results.
        <div style="padding-top: 1rem">
            <Sitegeist.FusionLinkPrototypes:ModuleLink
                content="Back to the overview"
                attributes.class="neos-button"
                module='management/link-checker'
                action='index'
            />
        </div>
    `
}

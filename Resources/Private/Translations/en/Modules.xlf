            </trans-unit>
            <trans-unit id="list.action.deleteShort">
                <source>Mark fixed</source>
            </trans-unit>
            <trans-unit id="list.action.ignore">
                <source>Ignore this error</source>
            </trans-unit>
            <trans-unit id="list.action.ignoreShort">
                <source>Ignore</source>
            </trans-unit>
            <trans-unit id="group.action.resolveAll">
                <source>Mark all fixed</source>
            </trans-unit>
            <trans-unit id="group.action.ignoreAll">
                <source>Ignore all</source>
            </trans-unit>
            <trans-unit id="group.rows.pages">
                <source>Found on these pages</source>
            </trans-unit>
            <trans-unit id="group.rows.targets">

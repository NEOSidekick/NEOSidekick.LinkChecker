            </trans-unit>
            <trans-unit id="error.307">
                <source>Temporary Redirect (307)</source>
            </trans-unit>
            <trans-unit id="error.308">
                <source>Permanent Redirect (308)</source>
            </trans-unit>
            <trans-unit id="error.400">
                <source>Bad Request (400)</source>
            </trans-unit>
            <trans-unit id="error.401">
                <source>Unauthorized (401)</source>
            </trans-unit>
            <trans-unit id="error.403">
